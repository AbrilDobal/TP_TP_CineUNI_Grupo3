{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "g++.exe - Compilar y depurar proyecto",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/programa.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Habilitar la impresión bonita para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++.exe compilar proyecto"
        }
    ]
}